module foo;
endmodule

module bar;
    real x, y;

    analog function real ln_one_plus_exp;
        input x; real x;
        if (x > 37) begin
            ln_one_plus_exp = x;
        end else if (x < -37) begin
            ln_one_plus_exp = exp(x);
        end else begin
            ln_one_plus_exp = ln(1.0 + exp(x));
        end
    endfunction

    analog begin
        begin: initialize
        x = 5.0;
            y = ln_one_plus_exp(x);
        end
    end
endmodule