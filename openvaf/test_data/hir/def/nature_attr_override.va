// Taken from LRM 3.6.2.5: Overriding nature attributes from discipline

nature ttl_curr;
    units = "A";
    access = I;
    abstol = 1u;
endnature

nature ttl_volt;
    units = "V";
    access = V;
    abstol = 100u;
endnature

discipline ttl;
    potential ttl_volt;
    flow ttl_curr;
    flow.abstol = 10u;
enddiscipline